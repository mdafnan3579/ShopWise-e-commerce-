# Copy this file to .env and fill in your key. .env is ignored by git, so the key stays private.
# Get a key at https://console.anthropic.com → API Keys (pay-as-you-go).
ANTHROPIC_API_KEY=

# Which Claude model to use. claude-opus-5-5 is the current default.
MODEL=claude-opus-5-5

# Steps 6–7: where the ShopWise backend runs, and which customer the agent logs in as.
# These are the public demo account from `npm run seed`, not real secrets.
SHOPWISE_API_URL=http://localhost:5000/api/v1
SHOPWISE_ORIGIN=http://localhost:5173
SHOPWISE_EMAIL=demo@shopwise.dev
SHOPWISE_PASSWORD=Demo@12345
