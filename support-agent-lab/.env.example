# Copy this file to .env and paste your key from console.anthropic.com → API Keys.
# .env is gitignored, so your key never gets committed.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Opus 5.5 is the smartest model. While experimenting you can switch to claude-haiku-5-5 to save money.
MODEL=claude-opus-5-5
