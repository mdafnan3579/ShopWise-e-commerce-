# Copy this file to .env and paste your key from https://aistudio.google.com/api-keys
# .env is gitignored, so your key never gets committed.
GEMINI_API_KEY=your-key-here

# gemini-3.8-flash is fast and has a free tier. Check https://ai.google.dev/gemini-api/docs/models for other models.
MODEL=gemini-3.8-flash
