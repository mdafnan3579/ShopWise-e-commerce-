# Copy to .env and fill in. Every variable is validated at startup (src/config/env.js) —
# the server refuses to start with a clear error if something is missing or malformed.

# --- Server ---
NODE_ENV=development
PORT=5000
# Comma-separated list of browser origins allowed by CORS (the React app)
CLIENT_URL=http://localhost:5173
# Number of reverse proxies in front of the app (1 on Render). Needed for correct client IPs
# in rate limiting and secure cookies.
TRUST_PROXY=0
# fatal | error | warn | info | debug | trace | silent  (default: debug in dev, info in prod)
LOG_LEVEL=

# --- Database ---
# `docker compose up -d mongo` starts a single-node replica set (required for transactions)
MONGODB_URI=mongodb://localhost:27017/shopwise?directConnection=true
