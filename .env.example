# Copy to .env and fill in. Every variable is validated at startup (src/config/env.js) —
# the server refuses to start with a clear error if something is missing or malformed.

# --- Server ---
NODE_ENV=development
PORT=5000
# Comma-separated list of browser origins allowed by CORS (the React app)
CLIENT_URL=http://localhost:5173
# Number of reverse proxies in front of the app (1 on Render). Needed for correct client IPs
# in rate limiting and secure cookies.
TRUST_PROXY=0
# fatal | error | warn | info | debug | trace | silent  (default: debug in dev, info in prod)
LOG_LEVEL=

# --- Database ---
# `docker compose up -d mongo` starts a single-node replica set (required for transactions)
MONGODB_URI=mongodb://localhost:27017/shopwise?directConnection=true

# --- Auth ---
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# lax when frontend and API share a site (localhost); none when they are on different sites in production
COOKIE_SAMESITE=lax
BCRYPT_ROUNDS=12

# --- Cloudinary (product image uploads) — optional in dev, required in production ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Stripe (test mode) — optional in dev, required in production ---
# Prefer a restricted key (rk_test_...) with write access to Checkout Sessions, Coupons and Refunds.
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:5000/api/v1/webhooks/stripe` or the Dashboard endpoint
STRIPE_WEBHOOK_SECRET=

# --- Email — without SMTP_HOST, emails are written to the log instead of sent ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=ShopWise <no-reply@shopwise.dev>

# --- AI (Anthropic) — server-side only. Without a key, AI features fall back to non-AI behavior ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_FAST_MODEL=claude-haiku-5-5
# Kill switch: set to false to turn every AI feature off without redeploying code
AI_ENABLED=true
# Retry policy-declined requests on Anthropic's recommended fallback model (beta)
AI_REFUSAL_FALLBACK=true
